<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      allowBackup is off so the credential cannot leave the device in a cloud
      backup (DESIGN.md "What the user can change", criterion settings-5).

      Cleartext is opted back into deliberately: Android blocks plain HTTP from
      targetSdk 28, but the backend is the user's own and is often a machine on
      their own network with no certificate (criterion settings-7).
    -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_blip"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Blip">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
