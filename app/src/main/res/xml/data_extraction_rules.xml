<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device. The credential is a setting like any other, and
  DESIGN.md "What the user can change" criterion settings-5 says it stays here.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
