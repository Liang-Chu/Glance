# Build output
build/
.gradle/
.cxx/
captures/
*.apk
*.aab
*.apks
# apksigner writes this beside a signed APK. "*.apk" does not match it, which is
# how one reached a commit.
*.idsig
*.hprof

# Machine-specific. sdk.dir differs on every machine and must never be committed.
local.properties

# Signing material
*.jks
*.keystore
keystore.properties

# Editors
.idea/
*.iml
.vscode/

# Agent tooling. Personal to whoever is working on this, and not part of the
# project — see CLAUDE.md, which is kept because it is about this repository.
.claude/

# OS noise
.DS_Store
Thumbs.db

# Python bytecode from the example backend
__pycache__/
*.pyc
